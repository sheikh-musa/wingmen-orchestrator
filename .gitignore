# secret-bearing + machine-local artifacts (never track — hygiene 2026-07-03)
.env.bak*
.env.*.bak
backups/
sandbox/

# Browser session-state dumps (Playwright/Puppeteer storageState) — these hold
# live Supabase auth tokens + plaintext refresh_tokens. One was found untracked
# AND ungitignored at the repo root, one `git add -A` from permanent history
# (fable substrate scan, critic #1). Never track any of them.
scratch_state.json
*storage_state*.json
*storageState*.json
*.session.json
playwright/.auth/
.lane_default_token
.orch_default_token
# all per-body token-pointers (point at OAuth key files) + their backups — same
# secret class as the above; never track (op#11761 'always commit and push' safety).
.cai_default_token
.fleet-health_default_token
.quality_default_token
# GAP-B per-GROUP token pointers (.group_default_token.<family>) — same secret
# class (they point at OAuth key files); never track.
.group_default_token.*
*_default_token.was.pre
*_default_token.musa.bak
*_default_token.pre
*_default_token.bak

# operator-provided credentials (claude.ai session token etc.) — never track
.secrets/

# session accumulation cleanup (op#10450) — never track:
.nazim_default_token
firebase-debug.log
*.log
# client-data / PII artifacts — must NOT go to GitHub (residency/PII, TENANT-RESIDENCY-001)
reports/*.png
reports/*.jpg
reports/*.jpeg
reports/*.pdf
reports/*.pptx
reports/*.csv
reports/cosem-offline-slice/
reports/demo-qa-seed/
reports/practical-parity/
