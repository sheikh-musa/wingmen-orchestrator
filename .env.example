# ── ANTHROPIC ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── TELEGRAM ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...          # existing CTO bot token
MUSA_TELEGRAM_ID=...            # your personal chat ID

# ── SUPABASE (new project — create at supabase.com) ─────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...     # service_role key (not anon)
SUPABASE_PROJECT_REF=xxxx       # from project settings URL

# ── GITHUB (personal account) ───────────────────────────────────
GITHUB_TOKEN=ghp_...            # personal access token (repo scope)
GITHUB_USERNAME=your_github_username

# ── VERCEL (personal account) ───────────────────────────────────
VERCEL_TOKEN=...                # from vercel.com/account/tokens
VERCEL_TEAM_ID=                 # leave BLANK for personal account

# ── TUNNEL ──────────────────────────────────────────────────────
TUNNEL_MODE=cloudflared         # or: ngrok
CLOUDFLARE_TUNNEL_TOKEN=        # fill if TUNNEL_MODE=cloudflared
NGROK_AUTH_TOKEN=               # fill if TUNNEL_MODE=ngrok
WEBHOOK_BASE_URL=https://orch.wingmen.dev  # or ngrok URL
WEBHOOK_PORT=8443                         # port for client bot webhook server

# ── WAVESPEED (MagiHuman video gen) ─────────────────────────────
WAVESPEED_API_KEY=              # from wavespeed.ai

# ── RESEND (email notifications) ────────────────────────────────
RESEND_API_KEY=                 # from resend.com — used for web bug reporter emails

# ── OPTIONAL ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=             # Phase 3B TTS only

# ── FLEET CONSOLE (nervous_system/console) ──────────────────────
# Primary gate: comma-separated Tailscale IPs allowed to reach /api/*.
# Checked against the REAL TCP peer address, never X-Forwarded-For. FAILS
# CLOSED if empty — every /api/* request 401s rather than defaulting open.
# Seed with the operator's phone + BOTH his Macs as anti-lockout recovery
# (phone-only strands him the moment it re-registers with a new tailnet IP).
# Real values belong in the untracked .env, NOT here.
CONSOLE_ALLOWED_IPS=100.x.x.x,100.x.x.x,100.x.x.x   # phone,Studio,MacBook
# DORMANT emergency recovery secret (Authorization: Bearer only). Leave
# unset/blank in normal operation — every use is logged loudly.
CONSOLE_BREAKGLASS_TOKEN=
CONSOLE_DB_URL=                 # DSN of the SELECT-only console_readonly role
CONSOLE_PORT=8787
# MUST be "auto" (binds this host's own Tailscale IP directly). NEVER
# 127.0.0.1 behind a tunnel — the tunnel makes every request's peer IP
# 127.0.0.1, which defeats CONSOLE_ALLOWED_IPS entirely (either total
# lockout, or turns the allowlist into theater if 127.0.0.1 is "fixed" onto
# it). No tunnel sits in front of this deployment; devices connect directly
# over Tailscale.
CONSOLE_HOST=auto

# ── BUG-PIPELINE-SYNTHETIC-FILTER-001 (2026-05-08) ─────────────────
# Dispatch-time auto-reject filter for synthetic E2E test bug reports.
#
# ENABLED kill-switch: set to "false" to bypass the filter entirely and
# revert to PR #28-only behavior (intake-side is_test flag still works).
# Default: true.
ORCHESTRATOR_SYNTHETIC_FILTER_ENABLED=true
#
# ENFORCE mode toggle. Default "false" → shadow mode (classify + log, do
# not block dispatch). Flip to "true" AFTER 48h+ shadow window with 5+
# samples and zero false-positives observed. Restart orchestrator after
# changing.
ORCHESTRATOR_SYNTHETIC_FILTER_ENFORCE=false
