<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.wingmen.orchestrator</string>
  <key>ProgramArguments</key>
  <!--
    Empty-export (NOT unset) ANTHROPIC_API_KEY before exec. wingmen_orch.py calls
    load_dotenv(), which with override=False re-adds any var ABSENT from the env —
    so a bare `unset` would be silently defeated and the loop would bill the metered
    Anthropic API instead of Max. An empty value stays PRESENT, so load_dotenv leaves
    it, and council's `if not api_key` guard refuses. See tests/test_boot_scripts_strip_api_key.py.
    (op#22407, Nazim #43280.)
  -->
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export ANTHROPIC_API_KEY=; exec /Users/sheikhmusa/wingmen/orchestrator/.venv/bin/python3 /Users/sheikhmusa/wingmen/orchestrator/wingmen_orch.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/orch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/orch.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/Users/sheikhmusa/wingmen/orchestrator/.venv/bin</string>
    <key>HOME</key>
    <string>/Users/sheikhmusa</string>
    <key>AUTOCC_POLL_ENABLED</key>
    <string>true</string>
  </dict>
</dict>
</plist>
