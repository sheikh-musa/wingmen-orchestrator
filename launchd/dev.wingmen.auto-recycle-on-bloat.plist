<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- auto-recycle-on-bloat. Independent of any agent's heartbeat (the recycler must
       survive the body it recycles). STAGE-1 (WARN) LIVE as of 2026-08-15 (nazim-signed
       op#13308 / bus 22320): AUTO_RECYCLE_STAGE1_WARN=1 posts a NON-destructive, deduped
       console WARN on each WOULD-FIRE (worker lane >=~85% pane-truth at clean idle) so a
       human/SRE recycles it before 100%. STILL FIRES NO RESET — Stage-2 (auto-recycle)
       stays separately GATED (audit-commit + self-checkpoint-pre-clear + coverage fix +
       nazim re-review). Detect+publish observe-ladder blessed bus 18526. -->
  <key>Label</key>
  <string>dev.wingmen.auto-recycle-on-bloat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/wingmen/orchestrator" &amp;&amp; set -a &amp;&amp; . ./.env &amp;&amp; set +a &amp;&amp; unset ANTHROPIC_API_KEY &amp;&amp; export AUTO_RECYCLE_STAGE1_WARN=1 &amp;&amp; exec .venv/bin/python3 -m scripts.auto_recycle_on_bloat</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/auto_recycle_stage0.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/auto_recycle_stage0.log</string>
</dict>
</plist>
