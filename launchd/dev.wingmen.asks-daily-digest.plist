<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.wingmen.asks-daily-digest</string>
  <key>ProgramArguments</key><array><string>/Users/sheikhmusa/wingmen/orchestrator/.venv/bin/python3</string><string>/Users/sheikhmusa/wingmen/orchestrator/scripts/asks_daily_digest.py</string></array>
  <key>WorkingDirectory</key><string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/sheikhmusa</string><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <!-- op#22669: operator (Musa) is UTC+4 (Abu Dhabi) -- memory
       user_operator_timezone_abu_dhabi.md. StartCalendarInterval fires in the
       HOST's local time zone; this Mac Mini's launchd jobs (see
       dev.wingmen.programme-stall-digest.plist's Hour=13 for a documented
       Monday-13:00 slot) are scheduled assuming the host clock is UTC, so
       09:00 Abu Dhabi = 05:00 UTC -> Hour=5 below. If this host is ever moved
       to run its system clock in Asia/Dubai instead, change Hour to 9. NOT
       launchctl-loaded by this PR -- landing this file alone does not make it
       live; a separate go-live step loads it. -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/asks-daily-digest.log</string>
  <key>StandardErrorPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/asks-daily-digest.log</string>
</dict>
</plist>
