<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mini realtime AUTO-WAKE subscriber (Gap B, CAI-RESP-706). Wake-only; wakes
     MINI lanes on directed agent_messages INSERTs. Runs in orch-console's (Nazim's)
     launchd domain. Mirrors dev.wingmen.weekly-alert-relay. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.wingmen.agent-wake-subscriber</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/boot_agent_wake_subscriber.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/agent-wake-subscriber.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sheikhmusa/wingmen/orchestrator/logs/agent-wake-subscriber.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/sheikhmusa</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
