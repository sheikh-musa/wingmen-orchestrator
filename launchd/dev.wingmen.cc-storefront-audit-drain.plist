<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CAI-1348 audit-board drainer — recurring scheduled sweep.

  Fires cc-storefront to drain its OWN stale decision_audits backlog via a
  DEDICATED worktree (CAI-RESP-1361 owner+sequencing; CAI-RESP-1348 cadence-fix
  root cause). Wrapper: scripts/cc_storefront_audit_drain_sweep.sh — pre-filters
  open audits, heartbeats + skips on an empty tick, else spawns a bounded
  opus-4-8 cc-storefront session (--scheduled-prompt skills/audit-drain-sweep-
  prompt.md) that fast-triages (CAI-RESP-1348 §1) or full-re-audits up to
  AUDIT_DRAIN_BATCH items and writes verdict+completed_at.

  Under launchd the env carries only PATH (below), so the CAI-1225 L2 write-DSN
  guard passes (no GOUMLYNE_DATABASE_URL/IHSANOS_PROD_DATABASE_URL present); the
  launcher self-sources .env for DATABASE_URL + RO DSNs + token.

  LOAD (only AFTER the mandatory test-fire proved >=1 real item drained — done
  2026-09-04, ids 238/240/241, all fast-triage, verdicts independently verified;
  and after cai's pre-load design look per CAI-RESP-1361):
    cp launchd/dev.wingmen.cc-storefront-audit-drain.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.wingmen.cc-storefront-audit-drain.plist
  UNLOAD:
    launchctl bootout gui/$(id -u)/dev.wingmen.cc-storefront-audit-drain
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.wingmen.cc-storefront-audit-drain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/cc_storefront_audit_drain_sweep.sh</string>
    </array>

    <!-- ~12h. Non-urgent audit-board hygiene; a purely wake-driven backlog
         demonstrably does not move (13+ real days), so this is the dedicated
         attention it otherwise never gets. -->
    <key>StartInterval</key>
    <integer>43200</integer>

    <!-- Don't fire on launchd boot; first fire happens StartInterval seconds
         after bootstrap. Avoids a load spike on Mac Mini wake-from-sleep. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/sheikhmusa/wingmen/orchestrator/logs/cc-storefront-audit-drain.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sheikhmusa/wingmen/orchestrator/logs/cc-storefront-audit-drain.err</string>

    <!-- Hard ceiling per tick. Each item's completion is a single atomic
         UPDATE, so a kill between items just leaves remaining items open
         (next tick takes them) — never a partial write. 900s gives a full
         re-audit room while --max-turns 30 remains the real bound. -->
    <key>ExitTimeOut</key>
    <integer>900</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/sheikhmusa/.npm-global/bin:/Users/sheikhmusa/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
