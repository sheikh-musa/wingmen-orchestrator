<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- client-channel no-drop watch, ARMED (held_commitment #314, orch-console #72395,
       2026-10-20): posts real bus nudges/pages (coord at 30m unanswered, orch-console/Nazim
       at 2h). Deliberately INCLUSIVE of parked channels (angullia/oeh) -- orch-console's
       ruling: a parked client re-engaging is exactly the case this watch must not miss,
       narrow to EXCLUDE_TAGS only on proven page-noise, not preemptively. -->
  <key>Label</key><string>dev.wingmen.client-nodrop-watch</string>
  <key>ProgramArguments</key><array>
    <string>/Users/sheikhmusa/wingmen/orchestrator/.venv/bin/python3</string>
    <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/client_channel_nodrop_watch.py</string>
    <string>--arm</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/client_channel_nodrop_watch.log</string>
  <key>StandardErrorPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/client_channel_nodrop_watch.log</string>
</dict></plist>
