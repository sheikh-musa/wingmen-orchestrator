<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.wingmen.priority-sla-watchdog</string>
  <key>ProgramArguments</key><array>
    <string>/Users/sheikhmusa/wingmen/orchestrator/.venv/bin/python3</string>
    <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/priority_sla_watchdog.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>RunAtLoad</key><true/>
  <!-- ~90s cadence: fast enough to catch a fresh P0/P1 within ~2 scans,
       slow enough to be gentle on the DB + tmux. -->
  <key>StartInterval</key><integer>90</integer>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/sheikhmusa</string>
    <!-- git<->live sync (Nazim #40776 disclosure-2): mirror the DEPLOYED live plist so
         committed==deployed. SLA_READ_PARKED_ENABLED=0 keeps the read-parked net INERT
         (op#11774 observe-first, not yet armed); SLA_EXCLUDE_AGENTS='' = nobody excluded
         from actioning. Pre-existed live-only; now tracked. -->
    <key>SLA_EXCLUDE_AGENTS</key><string></string>
    <key>SLA_READ_PARKED_ENABLED</key><string>0</string>
    <!-- SLOW-ASK PAGE ARMED (op#34803 part B, console ruling #78298, 2026-10-27): an operator
         ask with no lane ack within SLA_SLOW_ASK_ACK_MIN (default 20) pages orch-console once
         (slow_paged_at). Armed after #536's interim delegation-thread ack landed. -->
    <key>SLA_SLOW_ASK_ENABLED</key><string>1</string>
    <!-- RULING-3 AGED-RR RE-PAGE ARMED (Nazim #40752, 2026-09-16, after the clean soak
         #40750: 0 aged rr rows in observe = empty blast radius). Promotes PR#108's
         aged-unanswered-rr net from observe/inert to live: a P0/P1 rr the hub or SRE
         issued that sits unanswered AND UNREAD past 6h re-pages the OWNER body (hub /
         orch-console; NEVER the operator) at P1 every 6h until read. Arm-time watermark
         excludes all pre-existing backlog; per-scan cap 3; lease-gated; dead-man
         stamp-on-success-only. Flip to 0 to disarm. -->
    <key>SLA_AGED_REPAGE_ENABLED</key><string>1</string>
    <!-- ARMING CALENDAR hc#312/#313 (audit-20261006 B4/B-fix3, B4/C3; re-sequenced via
         orch-console #58089), fired+verified 2026-10-15: 60h+ continuous observe soak
         (log start 2026-10-12T23:59Z), ZERO errors across 2265 asks-chase + 1820
         captured-triage scans, spot-checked targets (#654/#728/#1812/#3249) all
         genuinely still-open/stale in operator_asks. All three nets post ONLY to
         internal fleet bus recipients (owning lane + orch-console) via agent_messages
         -- never a client, never the operator directly -- capped at 3 new chases/scan
         with per-ask dead-man's-switch dedup (never double-sent). SLA_ASKS_CHASE_ENABLED
         arms BOTH op#22669's operator-asks-chase net (migration 072) AND migration 082's
         captured-triage aggregate page (ONE P1/run, never per-row) -- same gate, by
         design (see priority_sla_watchdog.py comments at both call sites), not two
         decisions. SLA_CLIENT_ASKS_CHASE_ENABLED arms migration 085's client-channel
         net (hc#312) -- EVERY_MIN explicitly set to 1440 (24h) below to match hc#312's
         pre-cleared rate-limit; the code's bare default (240min/4h, inherited from the
         unrelated operator net) would have been MORE aggressive than what was soak-
         tested, so it is overridden rather than relied on. Flip either back to 0/unset
         to disarm. -->
    <key>SLA_ASKS_CHASE_ENABLED</key><string>1</string>
    <key>SLA_CLIENT_ASKS_CHASE_ENABLED</key><string>1</string>
    <key>SLA_CLIENT_ASKS_CHASE_EVERY_MIN</key><string>1440</string>
    <!-- Escalation thresholds / guards are read from these (defaults shown).
         Uncomment to override without editing code.
    <key>SLA_MAX_VIOLATION_AGE_MIN</key><string>1440</string>
    <key>SLA_RENUDGE_BACKOFF_MIN</key><string>15</string>
    <key>SLA_HARD_ESCALATE_P0_MIN</key><string>10</string>
    <key>SLA_HARD_ESCALATE_P1_MIN</key><string>20</string>
    <key>SLA_MAX_PAGES_PER_RUN</key><string>3</string>
    <key>SLA_CIRCUIT_BREAKER_MAX</key><string>25</string>
    -->
  </dict>
  <key>StandardOutPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/priority-sla-watchdog.out.log</string>
  <key>StandardErrorPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/priority-sla-watchdog.out.log</string>
</dict>
</plist>
