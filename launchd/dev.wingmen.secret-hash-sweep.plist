<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.wingmen.secret-hash-sweep</string>
  <!-- Recurring hash-identified secret-value sweep of recent Claude Code transcripts
       (orch-console P1 #48640). Catches what the regex scanner (nervous_system.
       secret_redact) misses: bot tokens, DSN passwords, client keys, OAuth tokens.

       ARMED (SECRET_SWEEP_ARM=1 below, orch-console #51400/#51411 GO): the wrapper runs
       secret_hash_sweep.py --execute --ledger. Any real secret span found is redacted
       in place -- size-preserving, live-append-safe (PR#285: aborts cleanly and retries
       next cycle if the file changed between read and write), and REVERSIBLE via an
       offset+hash8 ledger (NEVER plaintext backups, orch-console #48678). Identifier-shaped
       false positives (plain UUIDs, *_ID/*_UUID/*_ORG keys) are excluded (PR#284). Still
       pages orch-console (P1) with COUNTS ONLY (never a value) every time something is
       found. To fall back to DETECT-only, remove SECRET_SWEEP_ARM below. -->
  <key>ProgramArguments</key><array>
    <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/secret_hash_sweep_run.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sheikhmusa/wingmen/orchestrator</string>
  <key>RunAtLoad</key><true/>
  <!-- 2-hour cadence; the wrapper's 30h scan window gives generous overlap so nothing
       between runs is missed even if a run is skipped. -->
  <key>StartInterval</key><integer>7200</integer>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/sheikhmusa</string>
    <key>PYTHONPATH</key><string>/Users/sheikhmusa/wingmen/orchestrator</string>
    <!-- ARMED (orch-console #51400/#51411 GO, after PR#284 identifier-allowlist +
         PR#285 live-append-race-protection both merged + cc-quality PASS): auto-redacts
         in place now. Overridable: SECRET_SWEEP_WINDOW ("30 hours ago"), SECRET_SWEEP_BAK_ROOT. -->
    <key>SECRET_SWEEP_ARM</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/secret-hash-sweep.out.log</string>
  <key>StandardErrorPath</key><string>/Users/sheikhmusa/wingmen/orchestrator/logs/secret-hash-sweep.out.log</string>
</dict>
</plist>
