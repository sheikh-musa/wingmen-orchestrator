<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.wingmen.fleet-health-session</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/sheikhmusa/wingmen/orchestrator/scripts/boot_fleet_health_launchd.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sheikhmusa/wingmen/fleet-health</string>

  <!-- Start at login, keep alive so a crashed session auto-restarts -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Small delay at boot so tmux + auth are ready -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/Users/sheikhmusa/wingmen/fleet-health/logs/cc_fleet_health_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sheikhmusa/wingmen/fleet-health/logs/cc_fleet_health_launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/sheikhmusa</string>
    <key>PATH</key>
    <string>/Users/sheikhmusa/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>TERM</key>
    <string>xterm-256color</string>
  </dict>
</dict>
</plist>
