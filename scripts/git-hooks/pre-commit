#!/usr/bin/env bash
# pre-commit — refuse a cc-fleet-health (SRE) commit made INSIDE the console's live
# checkout (~/wingmen/orchestrator), which the fleet console SERVES. Branching/committing
# there switches the served tree off its trunk and lets a concurrent build subagent commit
# on top of the SRE branch — it corrupted the console once (Nazim #40776, 2026-09-16). The
# SRE must commit from its OWN git worktree instead:
#     git worktree add ~/wingmen/orch-<name>-wt -b <branch> fable/substrate-safe-fixes
#
# IDENTITY DISCRIMINATOR (revised, Nazim #40793): the shared host BLEEDS env between the
# console and the SRE sessions — in the SRE shell CC_BASE_AGENT_ID/AGENT_ID are EMPTY and
# ORCH_AGENT_ID leaks in as orch-console; and the checkout's git DEFAULT identity has
# collided with cc-fleet-health before (which misattributed a console build to the SRE). So
# a bare AGENT_ID check would FAIL-OPEN for the SRE, and a bare git-email check on the
# checkout DEFAULT would FALSE-BLOCK the console. Fix: gate everything behind the console
# top-level test (worktrees exit immediately), then OR several SRE signals — the RELIABLE
# one being the identity the SRE sets EXPLICITLY on every commit
# (`git -c user.name=cc-fleet-health -c user.email=<sre>`), read here as the EFFECTIVE
# user.name/user.email, which is immune to the ambient env bleed. A console build (default
# identity orch-console, no cc-fleet-health env) matches NONE of the signals -> passes.
#
# SECOND, INDEPENDENT CHECK — a SHARED-config identity set from inside a LINKED WORKTREE
# (orch-console #81957 -> GO #81978). Every worktree inherits <common>/.git/config, so
# `git config user.name` run inside a linked worktree sets the identity for the WHOLE repo:
# on 2026-10-29 one lane did exactly that and three other lanes' commits on
# fable/substrate-safe-fixes were then authored as it (14c44f1, fecd908, 5e9c9bc — content
# correct, author line false). A rule that lives only in docs does not survive a context
# reset, so the commit is refused instead. Only the MAIN checkout is exempt: there the
# shared config IS the checkout's own config, and refusing there would block legitimate
# console commits for a leak that only bites other worktrees. `git -c user.name=...` is
# never a config write, so per-command identity stays allowed; a worktree-scoped identity
# (git config --worktree) overrides the shared one and also stays allowed.
set -uo pipefail

_git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$_git_dir" ] && [ -n "$_common_dir" ]; then
  git_dir_abs="$(cd "$_git_dir" 2>/dev/null && pwd -P)"
  common_dir_abs="$(cd "$_common_dir" 2>/dev/null && pwd -P)"
  # Main checkout (git dir == common dir): the shared config is its own config. Nothing to guard.
  if [ -n "$git_dir_abs" ] && [ -n "$common_dir_abs" ] && [ "$git_dir_abs" != "$common_dir_abs" ]; then
    shared_config="$common_dir_abs/config"
    leaked=""
    for key in user.name user.email; do
      line="$(git config --show-origin --get "$key" 2>/dev/null || true)"
      [ -n "$line" ] || continue
      # --show-origin prints "<origin><TAB><value>"; split on a NAMED tab rather than an
      # invisible literal one, so a reformat cannot silently turn the separator into spaces.
      IFS="$(printf '\t')" read -r origin value <<<"$line"
      origin_path="${origin#file:}"
      case "$origin_path" in
        /*) ;;
        *) origin_path="$(cd "$(dirname "$origin_path")" 2>/dev/null && pwd -P)/$(basename "$origin_path")" ;;
      esac
      [ "$origin_path" = "$shared_config" ] && leaked="$leaked
     $key = $value"
    done
    if [ -n "$leaked" ]; then
      echo "" >&2
      echo "❌ pre-commit BLOCKED — this commit would be authored with a git identity stored in the" >&2
      echo "   SHARED config of this repo:" >&2
      echo "     $shared_config" >&2
      echo "   Every worktree inherits that file, so setting it from inside a linked worktree" >&2
      echo "   re-authors OTHER lanes' commits as you (2026-10-29: three lanes' commits were" >&2
      echo "   misattributed that way). Found:$leaked" >&2
      echo "" >&2
      echo "   Fix (worktree-scoped only, this worktree alone):" >&2
      echo "     git config extensions.worktreeConfig true" >&2
      echo "     git config --worktree user.name \"<your lane>\" && git config --worktree user.email \"<your lane>@wingmen.dev\"" >&2
      echo "   Or keep it per-command, writing no config file at all:" >&2
      echo "     git -c user.name=\"<your lane>\" -c user.email=\"<your lane>@wingmen.dev\" commit ..." >&2
      echo "   (Override only if you genuinely mean to set the fleet-wide identity: git commit --no-verify.)" >&2
      exit 1
    fi
  fi
fi

CONSOLE_CHECKOUT="/Users/sheikhmusa/wingmen/orchestrator"
SRE_ID="cc-fleet-health"
SRE_EMAIL="fleet.health@wingmen.fleet.local"

top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# Only the console's own checkout is guarded; every worktree has a different top-level and
# passes immediately, so the SRE's worktree commits are never touched.
[ "$top" = "$CONSOLE_CHECKOUT" ] || exit 0

email="$(git config user.email 2>/dev/null || true)"
name="$(git config user.name 2>/dev/null || true)"

is_sre=0
[ "$email" = "$SRE_EMAIL" ] && is_sre=1                 # explicit -c on every SRE commit (reliable)
[ "$name" = "$SRE_ID" ] && is_sre=1                     # explicit -c committer name (belt)
[ "${AGENT_ID:-}" = "$SRE_ID" ] && is_sre=1            # process identity, when present
[ "${CC_BASE_AGENT_ID:-}" = "$SRE_ID" ] && is_sre=1   # process identity, when present

[ "$is_sre" -eq 0 ] && exit 0

echo "" >&2
echo "❌ pre-commit BLOCKED — cc-fleet-health must NOT commit in the console's live checkout:" >&2
echo "     $CONSOLE_CHECKOUT" >&2
echo "   That tree is what the fleet console SERVES; branching/committing here switches it" >&2
echo "   off trunk and a build subagent can commit on top of yours (Nazim #40776)." >&2
echo "   Use your own worktree instead:" >&2
echo "     git worktree add ~/wingmen/orch-<name>-wt -b <branch> fable/substrate-safe-fixes" >&2
echo "     cd ~/wingmen/orch-<name>-wt   # then edit + commit here" >&2
echo "   (Override ONLY in a genuine emergency: git commit --no-verify — and say so.)" >&2
exit 1
