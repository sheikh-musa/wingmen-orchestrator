#!/usr/bin/env bash
# pre-push — two belts:
#   gate 1 (D#1, substrate audit 2026-09-16): if this push changes any *.py, the pytest
#     suite must still COLLECT cleanly — a deleted/renamed module a test imports must never
#     again silently abort collection and disable the whole suite unnoticed.
#   gate 2 (op#12457): blocks pushing console changes without a cc-quality review for the
#     CURRENT console content (the same gate as deploy_console.sh at push time).
# Belt to the deploy gate: no unreviewed console — and no un-collectable test tree — reaches
# the repo.
#
# It MUST hash exactly what the deploy gate reviews. It used to hand-roll a shasum over
# only five static files, which could never equal the gate's console_content_hash
# (~31 files: all served static + every backend *.py + the Dockerfile). So the review
# path it looked for never existed, it blocked every push, and it was routinely bypassed
# with --no-verify — a dead belt (substrate audit 2026-09-05 #2). Now it SOURCES the SSOT
# manifest and uses console_content_hash, so hook-hash == gate-hash by construction; and
# it inspects the REAL pushed range from stdin (not the old HEAD~1..HEAD) over the full
# gated file set (not just static/).
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"

# SSOT: the identical file set + content hash the deploy_console gate uses.
# HAVE_MANIFEST=0 when the current branch's lineage predates the console-deploy-
# gate feature (e.g. a branch based on `main`, which never received it) — gate 2
# below degrades to a no-op message in that case instead of crashing, since there
# is structurally no console-gate content on such a branch for it to protect.
# Console files and this manifest always land together on the trunk, so a branch
# that DOES carry console files also carries the manifest and still hits gate 2
# normally — nothing real is weakened by this guard.
MANIFEST="$ROOT/scripts/lib/console_deploy_manifest.sh"
HAVE_MANIFEST=0
GATED=()
if [ -f "$MANIFEST" ]; then
  HAVE_MANIFEST=1
  # shellcheck source=/dev/null
  . "$MANIFEST"
  # The gated file set as repo-relative pathspecs (served static + backend *.py + Dockerfile).
  # bash-3.2-safe array fill (no mapfile — macOS ships bash 3.2).
  while IFS= read -r _f; do
    [ -n "$_f" ] && GATED+=("$_f")
  done < <(console_deploy_files_rel "$ROOT")
fi

# Did any PUSHED commit touch a gated file? git streams one line per ref being pushed on
# stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>". Enforce only when gated
# content actually changed in the range base..local_sha (avoid re-triggering review on
# unrelated pushes).
#
# NEW-BRANCH BASE (Fable-audit follow-up, orch-console bus #46860 item 1): remote_sha is
# all-zeros for a brand-new branch. Diffing that against the EMPTY TREE made every gated
# file the branch carries — even byte-identical to the already-reviewed trunk — look like
# brand-new unreviewed content, and blocked a shell-only PR (#227) that touched no console
# file at all. Diff a new branch against its merge-base with the REVIEWED TRUNK instead:
# content identical to trunk is not new; content that actually changed relative to trunk
# still is, and is still blocked (case b below). If the trunk ref can't be resolved (no
# fetch, renamed remote) or shares no history with the pushed branch, fall back to the old
# conservative empty-tree diff — never silently widen the gate on an unknown base.
ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="$(git hash-object -t tree /dev/null)"
REVIEWED_TRUNK="origin/fable/substrate-safe-fixes"
changed=0
py_changed=0
while read -r _lref _lsha _rref _rsha; do
  [ -z "${_lsha:-}" ] && continue
  [ "$_lsha" = "$ZERO" ] && continue          # branch deletion — nothing to gate
  base="$_rsha"
  if [ "$_rsha" = "$ZERO" ]; then
    base=""
    trunk_sha="$(git rev-parse --verify -q "$REVIEWED_TRUNK" 2>/dev/null)"
    if [ -n "$trunk_sha" ]; then
      base="$(git merge-base "$trunk_sha" "$_lsha" 2>/dev/null)"
    fi
    [ -z "$base" ] && base="$EMPTY_TREE"      # safe default: unknown base -> conservative
  fi
  if [ "$HAVE_MANIFEST" -eq 1 ] && ! git diff --quiet "$base" "$_lsha" -- "${GATED[@]}" 2>/dev/null; then
    changed=1
  fi
  # Did this push touch any Python? (`*.py` is a git pathspec — matches .py at any depth.)
  # If so, gate 1 below verifies the test suite still collects.
  if ! git diff --quiet "$base" "$_lsha" -- '*.py' 2>/dev/null; then
    py_changed=1
  fi
done

# ── gate 1: pytest collection must stay clean (D#1, substrate audit 2026-09-16) ────
# A deleted module once silently disabled the ENTIRE suite: tests/migrations/
# test_bug024_identity_enforcement.py imported a removed applier, so `pytest tests/`
# aborted at collection — 0 of 2,778 tests ran and CI was red on every run, unnoticed.
# Collect-only imports every test module (NO fixtures, NO DB, NO test bodies) purely to
# prove they still import. Runs only when this push changes a *.py file. Prefer the repo
# venv; if no pytest is resolvable, warn and pass (CI is the backstop) rather than block a
# push over missing local dev deps — a hook that blocks unfixably just gets --no-verify'd.
if [ "$py_changed" -eq 1 ]; then
  PYTEST_PY="$ROOT/.venv/bin/python3"; [ -x "$PYTEST_PY" ] || PYTEST_PY="$(command -v python3 || true)"
  if [ -n "$PYTEST_PY" ] && "$PYTEST_PY" -c 'import pytest' >/dev/null 2>&1; then
    # Collect-only needs no DB, but conftest.py's prod-DB guard still fires at
    # pytest_configure time on whatever DATABASE_URL happens to be ambient in the
    # pushing shell -- a lane's shell exports the real substrate DSN by default, so
    # this scopes the subprocess env exactly like the documented safe local pattern
    # (env -u DATABASE_URL PYTEST_NO_DB=1) instead of inheriting it and refusing.
    if ! COLLECT="$(env -u DATABASE_URL -u SUPABASE_DB_URL PYTEST_NO_DB=1 "$PYTEST_PY" -m pytest -q --co -p no:cacheprovider tests/ 2>&1)"; then
      echo "" >&2
      echo "❌ pre-push BLOCKED — pytest collection FAILED; the test suite would not run." >&2
      printf '%s\n' "$COLLECT" | grep -E "ERROR|ModuleNotFoundError|Interrupted|error during collection" | head -20 >&2
      echo "   A test imports a module that no longer exists (deleted/renamed)? Fix it so every" >&2
      echo "   test collects and the suite actually runs." >&2
      echo "   (Override ONLY in a genuine emergency: git push --no-verify — and say so.)" >&2
      exit 1
    fi
  else
    echo "⚠ pre-push: no pytest available — skipping the test-collection check." >&2
  fi
fi

# ── gate 2: console content needs a cc-quality review (op#12457) ──────────────────
if [ "$HAVE_MANIFEST" -eq 0 ]; then
  echo "⚠ pre-push: console-deploy-gate manifest absent on this branch — gate 2 (console review) not applicable here." >&2
  exit 0
fi
[ "$changed" -eq 0 ] && exit 0

# Console content changed in this push — require a cc-quality review for THIS exact content.
HASH="$(console_content_hash "$ROOT")"
if [ -z "$HASH" ]; then
  echo "❌ pre-push BLOCKED — could not compute console content hash (manifest seam)." >&2
  exit 1
fi
REVIEW="reports/console-deploy/$HASH/cc-quality-review.md"
if [ ! -s "$REVIEW" ]; then
  # ABSOLUTE, not bare-relative (orch-console #52093/#52089/#52091): a bare relative
  # path left it ambiguous WHICH checkout "save the review here" meant, so a reviewer
  # following this text from a worktree saved it into ~/wingmen/orchestrator (the live
  # checkout) instead -- an untracked file that then collided with the PR's own tracked
  # copy on the next merge+pull. $ROOT is already correctly THIS checkout/worktree
  # (git rev-parse --show-toplevel, line 20 above); say so explicitly.
  echo "" >&2
  echo "❌ pre-push BLOCKED — console content changed but no cc-quality review for content $HASH." >&2
  echo "   The design-verification gate is enforced in code (op#12457). Save the review to" >&2
  echo "   THIS EXACT PATH (in this checkout/worktree, $ROOT -- nowhere else):" >&2
  echo "     $ROOT/$REVIEW" >&2
  echo "   scripts/deploy_console.sh can render + eyeball for you, BUT it always operates on" >&2
  echo "   \$HOME/wingmen/orchestrator (the live checkout) regardless of where you run it from --" >&2
  echo "   only safe to use when \$ROOT IS that live checkout. From a worktree, review the diff" >&2
  echo "   directly (git diff <merge-base> HEAD -- ${GATED[*]}) and save the review to the" >&2
  echo "   absolute path above." >&2
  echo "   (Override ONLY in a genuine emergency: git push --no-verify — and say so.)" >&2
  exit 1
fi
exit 0
